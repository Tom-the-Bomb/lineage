{
    "tabWidth": 4,
    "printWidth": 100,
    "singleQuote": true,
    "semi": true,
    "arrowParens": "avoid",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc", "*.md"],
            "options": { "tabWidth": 2 }
        }
    ],
    "plugins": [
        "prettier-plugin-organize-imports",
        "prettier-plugin-tailwindcss",
        "prettier-plugin-classnames",
        "prettier-plugin-merge"
    ]
}
